    },
    {
      "id": "msg-error",
      "kind": "error",
      "text": "주문 목록을 불러오지 못했습니다.",
      "when": "조회 오류"
    },
    {
      "id": "msg-query-too-long",
      "kind": "warning",
      "text": "주문번호는 20자 이내로 입력하세요.",
      "when": "검색어 글자수 초과"
    }
  ],
