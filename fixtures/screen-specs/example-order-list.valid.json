{
  "schema_version": "1.0",
  "screen_id": "EXAMPLE-order-list",
  "baseline_id": "example-baseline-1",
  "purpose": "주문 목록 조회 — 합성 예시. 검색 조건으로 더미데이터를 거르고 결과 표와 우측 설명을 같은 명세에서 만든다",
  "shell": "buyer-page",
  "device": "desktop",
  "roles": [
    "buyer"
  ],
  "requirements": [
    {
      "id": "EXAMPLE-REQ-001",
      "criterion_ids": [
        "EXAMPLE-AC-01",
        "EXAMPLE-AC-02",
        "EXAMPLE-AC-03"
      ]
    },
    {
      "id": "EXAMPLE-REQ-002",
      "criterion_ids": [
        "EXAMPLE-AC-04"
      ]
    }
  ],
  "sections": [
    {
      "id": "search",
      "title": "검색",
      "display_no": "1",
      "elements": [
        {
          "id": "query",
          "type": "text-input",
          "label": "주문번호",
          "required": false,
          "display_no": "a",
          "placeholder": "주문번호 입력",
          "max_length": 20,
          "validations": [
            {
              "rule": "max_length",
              "value": 20,
              "message_id": "msg-query-too-long"
            }
          ],
          "trace": [
            "EXAMPLE-AC-01"
          ],
          "note": "주문번호 부분 일치 검색. 검색 초기화 버튼은 두지 않는다(합성 프로파일 규칙; 설계 §9)"
        },
        {
          "id": "period",
          "type": "date-range",
          "label": "주문 기간",
          "display_no": "b",
          "trace": [
            "EXAMPLE-AC-01"
          ]
        },
        {
          "id": "status-filter",
          "type": "select",
          "label": "주문 상태",
          "display_no": "c",
          "options": [
            {
              "value": "",
              "label": "전체"
            },
            {
              "value": "EX_ORDERED",
              "label": "주문접수"
            },
            {
              "value": "EX_SHIPPED",
              "label": "배송중"
            },
            {
              "value": "EX_DONE",
              "label": "배송완료"
            }
          ],
          "trace": [
            "EXAMPLE-AC-01"
          ],
          "note": "상태값은 합성 값. 실제 상태 모델 정본은 unresolved 참조"
        },
        {
          "id": "search-button",
          "type": "button",
          "label": "검색",
          "display_no": "d"
        }
      ]
    },
    {
      "id": "results",
      "title": "주문 목록",
      "display_no": "2",
      "elements": [
        {
          "id": "order-table",
          "type": "table",
          "label": "주문 목록 표",
          "display_no": "a",
          "columns": [
            {
              "id": "order_no",
              "label": "주문번호",
              "sortable": true,
              "format": "text"
            },
            {
              "id": "ordered_at",
              "label": "주문일",
              "sortable": true,
              "format": "date"
            },
            {
              "id": "supplier_name",
              "label": "공급업체",
              "format": "text"
            },
            {
              "id": "amount",
              "label": "주문금액",
              "sortable": true,
              "format": "currency"
            },
            {
              "id": "status",
              "label": "주문상태",
              "format": "status"
            }
          ],
          "default_sort": {
            "column_id": "ordered_at",
            "direction": "desc"
          },
          "trace": [
            "EXAMPLE-AC-02"
          ],
          "note": "행을 누르면 주문 상세 팝업(open-order-detail)"
        },
        {
          "id": "download-button",
          "type": "button",
          "label": "엑셀 다운로드",
          "display_no": "b",
          "trace": [
            "EXAMPLE-AC-04"
          ]
        },
        {
          "id": "pager",
          "type": "pagination",
          "label": "페이지",
          "display_no": "c"
        }
      ]
    }
  ],
  "actions": [
    {
      "id": "search-submit",
      "type": "filter-fixture",
      "label": "검색",
      "trigger": "search-button",
      "target": "results",
      "trace": [
        "EXAMPLE-AC-01"
      ],
      "note": "검색 조건으로 fixture 행을 거른다. 결과가 0건이면 empty CASE 로 전이"
    },
    {
      "id": "sort-orders",
      "type": "sort-fixture",
      "label": "정렬",
      "target": "order-table",
      "trace": [
        "EXAMPLE-AC-02"
      ]
    },
    {
      "id": "download-orders",
      "type": "download-fixture",
      "label": "엑셀 다운로드",
      "trigger": "download-button",
      "target": "order-table",
      "trace": [
        "EXAMPLE-AC-04"
      ],
      "note": "표에 정의된 컬럼으로 예제 파일을 만든다 (설계 §9)"
    },
    {
      "id": "open-order-detail",
      "type": "open-popup",
      "label": "주문 상세",
      "target": "order-table",
      "target_screen_id": "EXAMPLE-order-detail-popup"
    },
    {
      "id": "show-empty",
      "type": "set-state",
      "label": "결과 없음 표시",
      "target_state_id": "empty",
      "trace": [
        "EXAMPLE-AC-03"
      ]
    },
    {
      "id": "show-error",
      "type": "set-state",
      "label": "조회 오류 표시",
      "target_state_id": "error"
    }
  ],
  "states": [
    {
      "id": "normal",
      "fixture_id": "orders-normal",
      "expected": "주문 3건이 주문일 내림차순으로 표시",
      "case_kind": "normal"
    },
    {
      "id": "searched",
      "fixture_id": "orders-searched",
      "expected": "주문번호 EX-2026-0002 와 일치하는 주문 1건 표시",
      "case_kind": "normal"
    },
    {
      "id": "empty",
      "fixture_id": "orders-empty",
      "expected": "조회 결과 없음 안내 표시, 표 본문은 비움",
      "case_kind": "empty",
      "message_ids": [
        "msg-empty"
      ]
    },
    {
      "id": "error",
      "fixture_id": "orders-error",
      "expected": "조회 오류 메시지 표시, 표는 비움",
      "case_kind": "error",
      "message_ids": [
        "msg-error"
      ]
    }
  ],
  "messages": [
    {
      "id": "msg-empty",
      "kind": "info",
      "text": "조회 결과가 없습니다.",
