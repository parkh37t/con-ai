# 모델 어댑터: anthropic(실제 호출) | fixture(더미, 기본)
MODEL_ADAPTER=fixture
MODEL_ID=claude-opus-5

# --- 모델 인증 (anthropic 어댑터를 쓸 때만) ---
# 어느 수단을 쓸지 고정한다: token | api_key | auto
#   token   내 Claude 구독 토큰 (권장 — 콘솔 결제 설정이 필요 없다)
#   api_key 콘솔에서 발급한 API 키 (사용량만큼 과금)
#   auto    ANTHROPIC_API_KEY → ANTHROPIC_AUTH_TOKEN → `ant auth login` 프로필 순서로 찾는다.
#           둘 다 채워 두면 API 키가 먼저 잡힌다 — 토큰을 쓰려면 token 으로 고정한다
MODEL_AUTH=token

# 내 Claude 구독 토큰. 발급: `claude setup-token` (Claude Code CLI, 구독 필요 · 장수명)
# Authorization: Bearer + anthropic-beta: oauth-2025-04-20 헤더로 나간다
ANTHROPIC_AUTH_TOKEN=

# API 키를 쓸 때만 (MODEL_AUTH=api_key). platform.claude.com 에서 발급
ANTHROPIC_API_KEY=

# 두 값 모두 **서버에만** 둔다. 브라우저·로그·응답·커밋에 절대 넣지 않는다.
# .env 는 .gitignore 에 있다. 값을 바꾸면 API 를 재시작한다
# 이 실행 환경처럼 Playwright 기본 브라우저 revision 이 없을 때 대체 실행 파일
PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium
# API 포트 / DB 파일
PORT=8787
CON_AI_DB=.local/con-ai.db

# --- AS-IS 분석 대상 URL 제한 (SSRF 차단, apps/api/src/ssrf.ts) ---
# 기본 동작: http/https 만 허용하고 **사설·루프백·링크로컬 대역은 차단**한다.
#   10/8·172.16/12·192.168/16(사설), 127/8·::1(루프백), 169.254/16(클라우드 메타데이터 169.254.169.254 포함)·fe80::/10,
#   0/8, 100.64/10(CGNAT), 192.0.0/24, 문서용 대역, 224/4·240/4, IPv6 ULA(fc00::/7).
#   호스트 이름은 A/AAAA 를 모두 해석해 하나라도 차단 대역이면 거부한다(해석 실패도 거부).
#   예외는 이 서버 자신의 데모 페이지 `/asis-sample`(PORT 와 같은 포트) 하나뿐이다.
# 사내망(스테이징·레거시 시스템)을 분석해야 할 때만 아래를 켠다. 공개 주소에 올린 서버에서는 켜지 않는다.
# ASIS_ALLOW_PRIVATE=1
# 특정 호스트만 열기(쉼표 구분). 정확히 일치하거나 `.example.com` 형태의 접미사. IP 검사를 건너뛴다
# ASIS_ALLOWED_HOSTS=legacy.staging.corp.example,.internal.corp.example
# 언제나 차단(위 두 설정보다 우선). 클라우드 메타데이터 호스트명 등
# ASIS_BLOCKED_HOSTS=metadata.google.internal,metadata.goog
