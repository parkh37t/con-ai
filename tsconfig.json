{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "workers/*/src/**/*.ts",
    "packages/*/src/**/*.ts",
    "fixtures/**/*.ts",
    "e2e/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist"
  ]
}
